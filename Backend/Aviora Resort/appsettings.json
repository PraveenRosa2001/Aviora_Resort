{
  "ConnectionStrings": {
    "AvioraDB": "Server=MR-PD\\SQLEXPRESS;Database=AvioraDB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True;"
  },

  "Jwt": {
    "//Key": "MUST be replaced. The placeholder below is public knowledge - anyone with it can mint an admin token for this API. Set it with: dotnet user-secrets set \"Jwt:Key\" \"<64 random characters>\"",
    "Key": "CHANGE-THIS-TO-A-LONG-RANDOM-SECRET-AT-LEAST-32-CHARACTERS",
    "Issuer": "AvioraResortAPI",
    "Audience": "AvioraResortClient",

    "//ExpiryDays": "Guest session lifetime.",
    "ExpiryDays": "7",

    "//AdminExpiryMinutes": "Admin session lifetime. Deliberately short - a stolen admin token exposes every guest record.",
    "AdminExpiryMinutes": "120"
  },

  "Lockout": {
    "//": "Tighter policy for administrators than for guests.",
    "GuestMaxAttempts": "5",
    "GuestMinutes": "15",
    "AdminMaxAttempts": "3",
    "AdminMinutes": "30"
  },

  "Email": {
    "//": "SMTP delivery for concierge replies, and for password reset next. Host, port and addresses are safe here; Password is NOT - see the note below.",

    "Host": "smtp.gmail.com",

    "//Port": "587 with STARTTLS. This is the port on GOOGLE's server, not one this app listens on - see the hosting note in EMAIL-SETUP.md.",
    "Port": 587,
    "UseStartTls": true,

    //"Username": "admin.avioraresort@gmail.com",
    "Username": "admin.avioraresort@gmail.com",

    "//Password": "LEAVE EMPTY. Set it with user-secrets, never in this file - it is in source control. dotnet user-secrets set \"Email:Password\" \"<app password, no spaces>\"",
    "Password": "omct fzne llpu onjd",

    "//FromAddress": "Must match Username for Gmail. Google rewrites a From it does not own, and a mismatch is a common reason replies land in spam.",
    //"FromAddress": "admin.avioraresort@gmail.com",
    "FromAddress": "admin.avioraresort@gmail.com",
    "FromName": "Aviora Resort Concierge",

    "//ReplyTo": "Where a guest's answer goes. Same inbox here; point it at the concierge address if that changes.",
    //"ReplyTo": "admin.avioraresort@gmail.com",
    "ReplyTo": "admin.avioraresort@gmail.com",

    "//Enabled": "false logs the whole message instead of connecting, and marks the reply Failed. A working state for development - the flow is exercised end to end without credentials.",
    "Enabled": true
  },

  "GoogleAuth": {
    "//": "ClientId is PUBLIC by design - it is compiled into the frontend bundle and sent to Google in the open on every sign-in. It is NOT a secret and does not belong in user-secrets. The client SECRET is a different thing entirely, and this flow does not use one: Google returns an ID token to the browser and the server verifies its signature against Google's published keys, so there is no code exchange and nothing here to steal.",

    "//Disable": "Leave ClientId empty to switch the feature off - the endpoint returns 503 and the button renders nothing. Password sign-in is unaffected.",
    "ClientId": "43388209018-r0b1jj3s2m4b7spne0h575f0kb6kk00u.apps.googleusercontent.com"
  },

  "Security": {
    "//ResetTokenMinutes": "How long a password reset link lives. Thirty minutes: long enough to find the mail on another device, short enough that a link left in an inbox on a shared machine stops being a key to the account before the day is out.",
    "ResetTokenMinutes": 30,

    "//ResetUrlBase": "Where the emailed link points. MUST match the route in AppRouter.jsx exactly, and must be the deployed frontend - a link to localhost is useless in every inbox but yours.",
    "ResetUrlBase": "http://localhost:5173/reset-password"
  },

  "Resort": {
    "//": "Printed in outbound mail. Configuration rather than constants, so changing the concierge number does not need a rebuild.",
    "ContactEmail": "admin.avioraresort@gmail.com",
    "ContactPhone": "+94 11 234 5678"
  },

  "Logging": {
    "//": "LogLevel is ENUMERATED by the logging provider: every key inside it is read as a category name and every value must parse as a log level. A '//' comment key belongs here, outside it - never inside. The SmtpEmailSender entry below logs every send and every failure with the provider's own message; worth keeping while email is new.",

    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "AvioraResort.Services.SmtpEmailSender": "Information"
    }
  },

  "AllowedHosts": "*"
}